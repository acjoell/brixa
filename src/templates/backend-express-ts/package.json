{
  "name": "brixa-tpl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild": false
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
