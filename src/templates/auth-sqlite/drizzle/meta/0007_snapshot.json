      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "activation_tokens_digest": {
          "name": "activation_tokens_digest",
          "value": "typeof(token_digest) = 'text' AND length(token_digest) = 64 AND token_digest NOT GLOB '*[^0-9a-f]*' AND instr(token_digest, char(0)) = 0"
        },
        "activation_tokens_dates": {
          "name": "activation_tokens_dates",
          "value": "typeof(issued_at) = 'integer' AND typeof(expires_at) = 'integer' AND (closed_at IS NULL OR typeof(closed_at) = 'integer') AND expires_at > issued_at"
        },
        "activation_tokens_lifecycle": {
          "name": "activation_tokens_lifecycle",
          "value": "(status = 'open' AND closed_at IS NULL) OR\n          (closed_at IS NOT NULL AND closed_at >= issued_at AND (\n            (status = 'consumed' AND closed_at < expires_at) OR\n            status = 'revoked' OR\n            (status = 'expired' AND closed_at >= expires_at)\n          ))"
        }
      }
    },
