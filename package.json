{
  "name": "brixa",
  "version": "0.1.0",
  "description": "CLI interactivo para generar proyectos web configurables.",
  "license": "AGPL-3.0-only",
  "author": "acjoell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acjoell/brixa.git"
  },
  "bugs": {
    "url": "https://github.com/acjoell/brixa/issues"
  },
  "homepage": "https://github.com/acjoell/brixa#readme",
  "keywords": [
    "cli",
    "scaffold",
    "generator",
    "react",
    "vite",
    "express",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "brixa": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "GENERATED_CODE_LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:generated": "node scripts/verify-generated.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.4"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
